{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "ca.mepc.verselight",
  "version": "2.1.2",
  "defaultMode": "window",
  "port": 47836,
  "documentRoot": "/resources/",
  "url": "/VerseLight.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "computer.*",
    "os.*",
    "filesystem.*",
    "clipboard.*",
    "extensions.*",
    "events.*"
  ],
  "modes": {
    "window": {
      "title": "MyVerse",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icone.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "MyVerse",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  },
  "enableExtensions": true,
  "extensions": [
    {
      "id": "ca.mepc.verselight.bridge",
      "commandWindows": "\"${NL_PATH}/extensions/bridge/verselight-bridge.exe\"",
      "commandLinux": "\"${NL_PATH}/extensions/bridge/verselight-bridge\""
    }
  ]
}