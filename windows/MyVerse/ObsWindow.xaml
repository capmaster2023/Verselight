<local:FenetreDialogue x:Class="MyVerse.Ui.ObsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="OBS" Width="620" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="OBS" Style="{StaticResource Titre2}" Margin="0,0,0,10" />
        <TextBlock Style="{StaticResource Muet}" FontSize="14"
                   Text="Afficher met la source MyVerse au premier plan dans OBS, Retirer l'enlève. Dans OBS : Outils › Paramètres du serveur WebSocket › cocher « Activer le serveur WebSocket »." />
        <CheckBox x:Name="Actif" Content="Piloter OBS (la source MyVerse apparaît et disparaît toute seule)" Margin="0,16,0,0" />
        <TextBlock Text="Nom de la source dans OBS" Style="{StaticResource Etiquette}" Margin="0,16,0,6" />
        <TextBox x:Name="Source" Style="{StaticResource Champ}" />
        <TextBlock Style="{StaticResource Muet}" Margin="0,4,0,0" FontSize="12"
                   Text="Facultatif : sans source de ce nom dans la scène, MyVerse ajoute lui-même une source « MyVerse (temporaire) »." />
        <TextBlock Text="Port du serveur" Style="{StaticResource Etiquette}" Margin="0,14,0,6" />
        <TextBox x:Name="Port" Style="{StaticResource Champ}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Text="Mot de passe du serveur" Style="{StaticResource Etiquette}" Margin="0,14,0,6" />
        <PasswordBox x:Name="Mdp" />
        <TextBlock x:Name="Statut" Style="{StaticResource Muet}" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Annuler" Style="{StaticResource Btn}" Content="Annuler" IsCancel="True" MinWidth="110" />
            <Button x:Name="Enregistrer" Style="{StaticResource BtnOr}" Content="Enregistrer" Margin="10,0,0,0" MinWidth="130" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</local:FenetreDialogue>
