<local:FenetreDialogue x:Class="MyVerse.Ui.TelephoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Télécommande Android" Width="860" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Télécommande Android" Style="{StaticResource Titre2}" Margin="0,0,0,14" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Border Width="280" Height="280" Background="White" CornerRadius="12">
                    <Grid>
                        <TextBlock x:Name="QrAttente" Text="Préparation du code…" Foreground="#10183A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" />
                        <Image x:Name="Qr" Width="264" Height="264" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Grid>
                </Border>
                <TextBlock x:Name="Info" Style="{StaticResource Muet}" Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run Text="Dans l'app" /> <Run Text="MyVerse" FontWeight="Bold" /><Run Text=", touchez" /> <Run Text="Scanner le code QR" FontWeight="Bold" /><Run Text=". Une seule fois : ensuite le téléphone se reconnecte tout seul, même si l'adresse du PC change." />
                </TextBlock>
                <TextBlock Style="{StaticResource Muet}" FontSize="14" Text="Le code n'est valable que tant que cette fenêtre est ouverte. Le téléphone et le PC doivent être sur le même Wi-Fi." />
                <TextBlock Text="Téléphones jumelés" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Or}" Margin="0,14,0,6" />
                <StackPanel x:Name="Liste" />
                <TextBlock x:Name="Parefeu" Style="{StaticResource Muet}" FontSize="14" Margin="0,10,0,0" />
                <Button x:Name="ParefeuBtn" Style="{StaticResource BtnPetit}" Content="Autoriser dans le pare-feu" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <Button x:Name="Fermer" Style="{StaticResource Btn}" Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Margin="0,16,0,0" IsCancel="True" />
    </StackPanel>
</local:FenetreDialogue>
