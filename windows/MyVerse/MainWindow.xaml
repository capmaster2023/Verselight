<Window x:Class="MyVerse.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="MyVerse — Bible et chants" Icon="/myverse.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Page}" Foreground="{StaticResource Blanc}"
        FontFamily="{StaticResource Ui}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="LigneVerset" TargetType="Border">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Nuit2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CarteSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Encre}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Trait2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ModeleChant">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnAjout}" Click="AjouterChantListe_Click" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock x:Name="Recueil" Text="{Binding Author}" FontSize="12.5" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Author}" Value="">
                    <Setter TargetName="Recueil" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- une ligne de l'agenda : pastille numérotée, titre, type ; « EN COURS » en pilule -->
        <DataTemplate x:Key="ModeleAgenda">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Pastille" Width="30" Height="30" CornerRadius="9" Background="{StaticResource Nuit2}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="Num" Text="{Binding Num}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Encre2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Titre" Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Type, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · " /><Run Text="{Binding Sous, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border x:Name="EnCours" Grid.Column="2" CornerRadius="10" Background="{StaticResource Blanc}" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="EN COURS" FontSize="10" FontWeight="Bold" Foreground="#FFF6E6" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EnCours}" Value="True">
                    <Setter TargetName="Pastille" Property="Background" Value="{StaticResource OrVif}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource SurOr}" />
                    <Setter TargetName="Titre" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="EnCours" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- ==================== barre du haut ==================== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Nuit}" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,0,0,1" Padding="22,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource OrVif}" VerticalAlignment="Center">
                            <Path Data="M11,7.5 A3.5,3.5 0 1 1 10.99,7.5 Z M11,1.5 V3.5 M11,18.5 V20.5 M4.3,4.3 L5.7,5.7 M16.3,16.3 L17.7,17.7 M1.5,11 H3.5 M18.5,11 H20.5 M4.3,17.7 L5.7,16.3 M16.3,5.7 L17.7,4.3"
                                  Stroke="{StaticResource SurOr}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MyVerse" FontFamily="{StaticResource UiTitre}" FontWeight="Bold" FontSize="23" VerticalAlignment="Center" Foreground="{StaticResource Blanc}" Margin="10,0,0,2" />
                        <Border x:Name="VersionPastille" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SousTitre" Text="5.1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                        </Border>
                        <Button x:Name="VersionBtn" Style="{StaticResource BtnPlat}" Padding="6,2" Margin="4,2,0,0" FontSize="12" Foreground="{StaticResource Brume}" ToolTip="Vérifier les mises à jour" Content="v5" Visibility="Collapsed" />
                        <Button x:Name="MajBtn" Style="{StaticResource BtnPetitOr}" Margin="8,0,0,0" Visibility="Collapsed" Content="Mettre à jour" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F3ECDF" CornerRadius="14" Padding="4" Margin="22,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OngletAgenda" Style="{StaticResource Onglet}" GroupName="Onglets" Content="Agenda" ToolTip="Préparer et projeter le culte (Ctrl K)" />
                            <RadioButton x:Name="OngletBible" Style="{StaticResource Onglet}" GroupName="Onglets" IsChecked="True" Content="Bible" Margin="2,0,0,0" />
                            <RadioButton x:Name="OngletChants" Style="{StaticResource Onglet}" GroupName="Onglets" Content="Chants" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- recherche : Bible ou chants selon l'onglet (l'agenda a sa barre de commande) -->
                    <Grid Grid.Column="2" Margin="20,0" MaxWidth="720" HorizontalAlignment="Stretch">
                        <Border x:Name="RechercheBible" Background="{StaticResource Nuit2}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="13" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                                <TextBlock x:Name="QIndice" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="jn 3 16 · ps 23 · rm 8.28 · ou des mots, même mal écrits" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Q" Grid.Column="1" Margin="10,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource Or}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" />
                                <Button x:Name="QEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                            </Grid>
                        </Border>
                        <Border x:Name="RechercheChants" Background="{StaticResource Nuit2}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="13" Padding="14,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                                <TextBlock x:Name="QcIndice" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="Chercher un chant : titre, numéro ou paroles" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Qc" Grid.Column="1" Margin="10,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource Or}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" />
                                <Button x:Name="QcEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Où part la diapositive">
                            <Ellipse x:Name="ProjPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,7,0" />
                            <TextBlock x:Name="ProjTexte" Text="Aperçu seulement" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ObsBtn" Style="{StaticResource BtnPlat}" Padding="10,8" ToolTip="Piloter OBS">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ObsPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                <TextBlock x:Name="ObsTexte" Text="OBS" FontSize="13" Foreground="{StaticResource Brume}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TelBtn" Style="{StaticResource BtnPlat}" Padding="10,8" ToolTip="Télécommande Android">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TelPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                <TextBlock x:Name="TelTexte" Text="Téléphone" FontSize="13" Foreground="{StaticResource Brume}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OutilsBtn" Style="{StaticResource Btn}" Width="44" Height="44" Padding="0" Margin="8,0,0,0" ToolTip="Outils : mise à jour, transfert, journal d'erreurs">
                            <Path Data="M3,5 H11 M15,5 H17 M3,10 H5 M9,10 H17 M3,15 H13 M17,15 H17 M13,3 V7 M7,8 V12 M15,13 V17" Stroke="{StaticResource Blanc}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== colonne de droite : en direct ==================== -->
            <Border x:Name="Colonne" DockPanel.Dock="Right" Width="400" Background="{StaticResource Page}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,16,22,16">
                        <Border Style="{StaticResource Carte}" Padding="16">
                        <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="EcranInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Rouge}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="EN DIRECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Direct}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Border x:Name="Apercu" BorderBrush="{StaticResource Nuit3}" BorderThickness="1.5" CornerRadius="14" Background="{StaticResource Damier}"
                                    ToolTip="Double-clic : couper cette diapositive" Cursor="Hand">
                                <Viewbox Stretch="Uniform">
                                    <local:Rendu x:Name="ApercuRendu" Width="1920" Height="1080" Transitions="False" />
                                </Viewbox>
                            </Border>
                            <Border x:Name="Pastille" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="6" Padding="8,2" Background="#B3FFFFFF">
                                <TextBlock x:Name="PastilleTexte" Text="Écran fermé" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource Nuit2}" CornerRadius="12" Padding="12,9" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="Decouper" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="Découper" IsEnabled="False"
                                            ToolTip="Couper la diapositive suivante en plusieurs (Entrée devant une ligne)" />
                                    <TextBlock Text="SUIVANT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SuivantLab" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Or}" Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <TextBlock x:Name="SuivantTexte" Text="—" FontSize="13" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Encre2}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Prec" Style="{StaticResource Btn}" Content="‹" FontSize="22" Padding="0" Height="52" ToolTip="Précédent (flèche gauche)" />
                            <Button x:Name="Afficher" Grid.Column="2" Style="{StaticResource BtnOr}" Content="Afficher" FontSize="18" Height="52" Padding="0" ToolTip="Entrée" />
                            <Button x:Name="Suiv" Grid.Column="4" Style="{StaticResource Btn}" Content="›" FontSize="22" Padding="0" Height="52" ToolTip="Suivant (flèche droite ou espace)" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Noir" Style="{StaticResource Btn}" Content="Écran noir" Height="44" Padding="0" ToolTip="Cache le texte sans le perdre (B)" />
                            <Button x:Name="Effacer" Grid.Column="2" Style="{StaticResource BtnRouge}" Content="Retirer" Height="44" Padding="0" ToolTip="Échap" />
                        </Grid>
                        </StackPanel>
                        </Border>

                        <!-- minuteur de prédication -->
                        <Border Style="{StaticResource Carte}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="MinuteurTemps" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" Text="00:00 / 45:00" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Minuteur de prédication" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="Visible pour le prédicateur" FontSize="12" Foreground="{StaticResource Brume}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,7,0,0" Height="4">
                                <Border Background="{StaticResource Nuit3}" CornerRadius="2" />
                                <Border x:Name="MinuteurBarre" Background="{StaticResource OrVif}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button x:Name="MinuteurBtn" Style="{StaticResource BtnPetit}" Content="Démarrer" MinWidth="96" />
                                <Button x:Name="MinuteurZero" Style="{StaticResource BtnPetit}" Content="Remettre à zéro" Margin="6,0,0,0" />
                                <ComboBox x:Name="MinuteurDuree" Width="96" Margin="6,0,0,0" ToolTip="Durée prévue">
                                    <ComboBoxItem Tag="20" Content="20 min" />
                                    <ComboBoxItem Tag="30" Content="30 min" />
                                    <ComboBoxItem Tag="35" Content="35 min" />
                                    <ComboBoxItem Tag="40" Content="40 min" />
                                    <ComboBoxItem Tag="45" Content="45 min" IsSelected="True" />
                                    <ComboBoxItem Tag="60" Content="60 min" />
                                    <ComboBoxItem Tag="90" Content="90 min" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        </Border>

                        <!-- l'assemblée suit sur son téléphone -->
                        <Border Style="{StaticResource Carte}" Margin="0,14,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="L'assemblée suit sur son téléphone" FontFamily="{StaticResource UiTitre}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="118" Height="118" Background="White">
                                        <Image x:Name="SuivreQr" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Scannez pour suivre" FontWeight="Bold" FontSize="14" />
                                        <TextBlock x:Name="SuivreUrl" FontSize="12" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="Même Wi-Fi que l'église. Chacun choisit sa langue." Style="{StaticResource MuetPetit}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="QrEcran" DockPanel.Dock="Right" Content="QR à l'écran" FontSize="13" ToolTip="Montre le code QR dans un coin de l'écran de projection" />
                                    <TextBlock x:Name="SuivreNb" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Text="Personne ne suit pour l'instant" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Carte}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                        <TextBlock Text="HABILLAGE DE L'ÉCRAN" Style="{StaticResource CarteTitre}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Fond" FontSize="13" Foreground="{StaticResource Brume}" Margin="0,0,0,4" />
                                <ComboBox x:Name="Theme" ToolTip="Fond de l'écran">
                                    <ComboBoxItem Tag="nuit" Content="Nuit" />
                                    <ComboBoxItem Tag="aube" Content="Aube" />
                                    <ComboBoxItem Tag="noir" Content="Noir" />
                                    <ComboBoxItem Tag="vert" Content="Vert (incrustation)" />
                                    <ComboBoxItem Tag="transparent" Content="Transparent (OBS)" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Présentation" FontSize="13" Foreground="{StaticResource Brume}" Margin="0,0,0,4" />
                                <ComboBox x:Name="Presentation" ToolTip="Présentation">
                                    <ComboBoxItem Tag="plein" Content="Plein écran" />
                                    <ComboBoxItem Tag="bandeau" Content="En bandeau" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Taille du texte" FontSize="13" Foreground="{StaticResource Brume}" Margin="0,14,0,2" />
                        <Slider x:Name="Taille" Minimum="0.6" Maximum="1.2" SmallChange="0.05" LargeChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" />

                        <TextBlock Text="RACCOURCIS" Style="{StaticResource CarteTitre}" Margin="0,22,0,8" />
                        <WrapPanel x:Name="Aide" />
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="Centre">
                <!-- ==================== agenda (comme VideoPsalm) ==================== -->
                <Grid x:Name="PanneauAgenda" Margin="22,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColonneAgenda" Width="360" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Carte}" Padding="16">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F3ECDF" CornerRadius="14" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="VueAgenda" Style="{StaticResource Onglet}" GroupName="Gauche" IsChecked="True" Content="Agenda" />
                                <RadioButton x:Name="VueNotes" Style="{StaticResource Onglet}" GroupName="Gauche" Content="Notes de prédication" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <DockPanel x:Name="BlocAgenda">
                                <ComboBox x:Name="AgendaChoix" DockPanel.Dock="Top" ToolTip="Agenda (un par culte)" MaxDropDownHeight="420" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="-4,6,0,4">
                                    <Button x:Name="AgendaNouveau" Style="{StaticResource BtnPlat}" Padding="8,6" FontSize="13" Content="+ Nouvel agenda" />
                                    <Button x:Name="AgendaRenommer" Style="{StaticResource BtnPlat}" Padding="8,6" FontSize="13" Content="Renommer" />
                                    <Button x:Name="AgendaSupprimer" Style="{StaticResource BtnPlat}" Padding="8,6" FontSize="13" Content="Supprimer" Foreground="{StaticResource Danger}" />
                                </StackPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,2,0,10">
                                    <TextBlock x:Name="AgendaProgres" DockPanel.Dock="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brume}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Grid x:Name="AgendaPiste" Height="6" VerticalAlignment="Center">
                                        <Border Background="#F1E9DA" CornerRadius="3" />
                                        <Border x:Name="AgendaBarre" Background="{StaticResource OrVif}" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                                    </Grid>
                                </DockPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AgendaHaut" Style="{StaticResource Btn}" Padding="0" Height="40" ToolTip="Monter" IsEnabled="False">
                                        <Path Data="M0,6 L5,1 L10,6" Stroke="{StaticResource Blanc}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Button>
                                    <Button x:Name="AgendaBas" Grid.Column="2" Style="{StaticResource Btn}" Padding="0" Height="40" ToolTip="Descendre" IsEnabled="False">
                                        <Path Data="M0,1 L5,6 L10,1" Stroke="{StaticResource Blanc}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Button>
                                    <Button x:Name="AgendaRetirer" Grid.Column="4" Style="{StaticResource Btn}" Content="Retirer" Padding="0" Height="40" FontSize="14" Foreground="{StaticResource Danger}" IsEnabled="False" />
                                    <Button x:Name="AgendaTexte" Grid.Column="6" Style="{StaticResource Btn}" Content="+ Texte" Padding="0" Height="40" FontSize="14" ToolTip="Annonce, prière, texte libre (une diapositive par paragraphe)" />
                                </Grid>
                                <Grid>
                                    <ListBox x:Name="ListeAgenda" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleAgenda}"
                                             BorderBrush="{StaticResource Nuit3}" />
                                    <TextBlock x:Name="AgendaVide" Margin="6,12,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" IsHitTestVisible="False"
                                               Text="L'agenda est vide. Ajoutez des chants et des versets avec la barre de commande (Tab), « + Agenda » dans Bible et Chants, ou vos notes de prédication." />
                                </Grid>
                            </DockPanel>
                            <DockPanel x:Name="BlocNotes" Visibility="Collapsed">
                                <TextBlock DockPanel.Dock="Top" Text="Collez vos notes (Word, WhatsApp…) : les versets sont trouvés tout seuls. F1 à F9 les affichent." Style="{StaticResource MuetPetit}" Margin="0,0,0,8" />
                                <TextBox x:Name="Notes" DockPanel.Dock="Top" Style="{StaticResource Zone}" Height="210" FontSize="14" />
                                <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
                                    <Button x:Name="NotesTout" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="Tout ajouter à l'agenda" IsEnabled="False" />
                                    <TextBlock x:Name="NotesNb" FontWeight="Bold" VerticalAlignment="Center" Text="Aucun verset trouvé" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="NotesRefs" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="2">
                        <Border x:Name="CmdBoite" DockPanel.Dock="Top" Background="{StaticResource Encre}" BorderBrush="{StaticResource OrVif}" BorderThickness="2" CornerRadius="16" Padding="16,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Or}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="22" Height="22" Stretch="None" />
                                <TextBlock x:Name="CmdIndice" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="19" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="jean 3 16 · chant 45 · minuteur 35 · ou des mots" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Cmd" Grid.Column="1" Margin="12,0,0,0" FontSize="20" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource Or}" VerticalContentAlignment="Center" Padding="0,15" FocusVisualStyle="{x:Null}" />
                                <Border Grid.Column="2" Style="{StaticResource Touche}" Margin="8,0,0,0">
                                    <TextBlock Text="Ctrl K" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="CmdResultatsBoite" DockPanel.Dock="Top" Margin="0,8,0,0" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="16" Padding="6" Visibility="Collapsed">
                            <StackPanel x:Name="CmdResultats" />
                        </Border>
                        <TextBlock x:Name="CmdAide" DockPanel.Dock="Top" Margin="4,7,0,0" Style="{StaticResource MuetPetit}" Text="Entrée : afficher · Tab : ajouter à l'agenda · ↑ ↓ : choisir" />

                        <StackPanel DockPanel.Dock="Top" Margin="0,22,0,10">
                            <DockPanel>
                                <TextBlock x:Name="ElemType" DockPanel.Dock="Left" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" Margin="0,4,10,0" />
                                <TextBlock x:Name="ElemTitre" Style="{StaticResource Titre2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Choisissez un élément de l'agenda" />
                            </DockPanel>
                            <StackPanel x:Name="ElemBoutons" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                <Button x:Name="ElemAfficher" Style="{StaticResource BtnPetitOr}" Content="Afficher depuis le début" />
                                <Button x:Name="ElemModifier" Style="{StaticResource BtnPetit}" Content="Modifier" Margin="8,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="DefilDiapos" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="Diapos" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ==================== Bible ==================== -->
                <Grid x:Name="PanneauBible" Margin="22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColonneCote" Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                        <StackPanel>
                            <Border Style="{StaticResource Carte}">
                                <StackPanel>
                                    <TextBlock Text="BIBLES" Style="{StaticResource CarteTitre}" />
                                    <StackPanel x:Name="BiblesChoix" Margin="0,6,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Trait2}" StrokeDashArray="4 3" StrokeThickness="1" IsHitTestVisible="False" />
                                        <Button x:Name="BiblesImporter" Style="{StaticResource Btn}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Or}" Padding="10" Content="+ Importer une Bible" />
                                    </Grid>
                                    <TextBlock x:Name="BiblesEtat" Style="{StaticResource MuetPetit}" Margin="0,8,0,0">
                                        <Run Text="Cliquez une Bible pour l'afficher ·" /> <Run Text="2e" FontWeight="Bold" /> <Run Text="= versets bilingues (sous le verset)" />
                                    </TextBlock>
                                    <Button x:Name="BiblesGerer" Style="{StaticResource BtnLien}" Content="Gérer les Bibles…" Margin="0,8,0,0" ToolTip="Supprimer une Bible, choisir dans une liste" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Carte}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ANCIEN TESTAMENT" Style="{StaticResource CarteTitre}" Margin="0,0,0,6" />
                                    <UniformGrid x:Name="LivresAT" Columns="3" />
                                    <TextBlock Text="NOUVEAU TESTAMENT" Style="{StaticResource CarteTitre}" Margin="0,12,0,6" />
                                    <UniformGrid x:Name="LivresNT" Columns="3" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" MinHeight="38" Margin="0,0,0,10" LastChildFill="False">
                                <Button x:Name="AgendaAjoutBible" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="+ Agenda" Margin="10,0,0,0" ToolTip="Ajouter les versets choisis (ou le chapitre) à l'agenda" VerticalAlignment="Center" />
                                <TextBlock x:Name="VersionsLab" DockPanel.Dock="Right" Style="{StaticResource Muet}" VerticalAlignment="Center" Text="Version : LSG" Margin="12,0,0,0" TextWrapping="NoWrap" />
                                <Button x:Name="ChapPrec" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="‹" ToolTip="Chapitre précédent" Visibility="Collapsed" VerticalAlignment="Center" />
                                <TextBlock x:Name="TitreChap" DockPanel.Dock="Left" Style="{StaticResource Titre2}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ChapSuiv" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="›" ToolTip="Chapitre suivant" Visibility="Collapsed" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer x:Name="DefilVersets" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <StackPanel x:Name="Versets" MaxWidth="1300" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ==================== chants ==================== -->
                <Grid x:Name="PanneauChants" Margin="22,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button x:Name="SupprimerRecueil" DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Supprimer" Margin="8,0,0,0" ToolTip="Supprimer ce recueil et ses chants" />
                            <ComboBox x:Name="Recueil" ToolTip="Recueil" MaxDropDownHeight="520" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                            <Button x:Name="Importer" Style="{StaticResource BtnOr}" Content="+ Importer chants / recueil"
                                    ToolTip="Ajouter des chants ou un recueil : VideoPsalm, OpenLyrics, OpenSong, ChordPro, SongSelect, ProPresenter 6, PDF, texte collé, lien d'un site" />
                            <Button x:Name="Nouveau" Style="{StaticResource Btn}" Content="+ Nouveau chant" Margin="0,8,0,0"
                                    ToolTip="Taper ou coller un chant : il est rangé tout seul en diapositives" />
                        </StackPanel>
                        <Border x:Name="NumBoite" DockPanel.Dock="Top" Margin="0,0,0,8" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10" Padding="12,0,4,0"
                                ToolTip="Taper le numéro du chant dans ce recueil (Entrée : ouvrir, puis 1-9 pour les strophes)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="N°" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" />
                                <TextBlock x:Name="NumIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="Numéro du chant" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="NumChant" Grid.Column="1" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}" MaxLength="6"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource Or}" VerticalContentAlignment="Center" Padding="0,8" FocusVisualStyle="{x:Null}" InputMethod.IsInputMethodEnabled="False" />
                                <Button x:Name="NumEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,2" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer le numéro" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ListBox x:Name="ListeChants" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleChant}" />
                            <TextBlock x:Name="ListeVide" Margin="6,14,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="ChantTitre" Style="{StaticResource Titre2}" Text="Aucun chant choisi" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AgendaAjoutChant" Style="{StaticResource BtnPetit}" Content="+ Agenda" IsEnabled="False" ToolTip="Ajouter ce chant à l'agenda" />
                                <Button x:Name="Modifier" Style="{StaticResource BtnPetit}" Content="Modifier" IsEnabled="False" Margin="8,0,0,0" />
                                <Button x:Name="Supprimer" Style="{StaticResource BtnDanger}" Content="Supprimer" IsEnabled="False" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="DefilSections" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="Sections" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- message court -->
        <Border x:Name="ToastBoite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Background="{StaticResource Blanc}" BorderThickness="0"
                CornerRadius="12" Padding="18,10" MaxWidth="900" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastTexte" TextWrapping="Wrap" Foreground="White" />
        </Border>
    </Grid>
</Window>
