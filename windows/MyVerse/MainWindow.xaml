<Window x:Class="MyVerse.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="MyChurch — Bible et chants" Icon="/myverse.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Page}" Foreground="{StaticResource Blanc}"
        FontFamily="{StaticResource Ui}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="LigneVerset" TargetType="Border">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Nuit2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CarteSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Encre}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Trait2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ModeleChant">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnAjout}" Click="AjouterChantListe_Click" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock x:Name="Recueil" Text="{Binding Author}" FontSize="12.5" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Author}" Value="">
                    <Setter TargetName="Recueil" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- une ligne du déroulé : heure, icône du type (coche si fait), titre ; « EN COURS » en pilule -->
        <DataTemplate x:Key="ModeleAgenda">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heure" Text="{Binding Heure}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                <Border x:Name="Pastille" Grid.Column="1" Width="30" Height="30" CornerRadius="9" Background="{StaticResource Nuit2}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path x:Name="Icone" Data="{Binding Icone}" Stroke="{StaticResource Brume}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Titre" Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock x:Name="Sous" Text="{Binding Sous}" FontSize="12" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="EnCours" Grid.Column="3" CornerRadius="10" Background="{StaticResource Blanc}" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="EN COURS" FontSize="10" FontWeight="Bold" Foreground="#FFF6E6" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Fait}" Value="True">
                    <Setter TargetName="Pastille" Property="Background" Value="#EAF4EA" />
                    <Setter TargetName="Icone" Property="Stroke" Value="#2F6B3A" />
                    <Setter TargetName="Titre" Property="Foreground" Value="{StaticResource Encre2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EnCours}" Value="True">
                    <Setter TargetName="Pastille" Property="Background" Value="{StaticResource OrVif}" />
                    <Setter TargetName="Icone" Property="Stroke" Value="{StaticResource SurOr}" />
                    <Setter TargetName="Heure" Property="Foreground" Value="{StaticResource Or}" />
                    <Setter TargetName="Heure" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Titre" Property="Foreground" Value="{StaticResource Blanc}" />
                    <Setter TargetName="Titre" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Sous" Property="Foreground" Value="#6B5428" />
                    <Setter TargetName="EnCours" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- une display de la bibliothèque -->
        <DataTemplate x:Key="ModeleAnnonce">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnAjout}" Click="GrilleAnnonceListe_Click" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Ajouter à la grille (un clic dans la grille = en direct)" />
                <Button Grid.Column="2" Style="{StaticResource Btn}" Click="ModifierAnnonceListe_Click" Content="Modifier" FontSize="12" Padding="9,5" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Modifier le titre ou le texte" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock Text="{Binding Description}" FontSize="12.5" MaxHeight="18" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- ==================== barre du haut ==================== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Nuit}" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,0,0,1" Padding="22,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource OrVif}" VerticalAlignment="Center">
                            <Path Data="M2,11 L11,5 L20,11 M4,10 V20 H18 V10 M11,1 V6 M8,3 H14 M8,20 V15 A3,3 0 0 1 14,15 V20"
                                  Stroke="{StaticResource SurOr}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MyChurch" FontFamily="{StaticResource UiTitre}" FontWeight="Bold" FontSize="23" VerticalAlignment="Center" Foreground="{StaticResource Blanc}" Margin="10,0,0,2" />
                        <Border x:Name="VersionPastille" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SousTitre" Text="6.0.0 β" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                        </Border>
                        <Button x:Name="VersionBtn" Style="{StaticResource BtnPlat}" Padding="6,2" Margin="4,2,0,0" FontSize="12" Foreground="{StaticResource Brume}" ToolTip="Vérifier les mises à jour" Content="v5" Visibility="Collapsed" />
                        <Button x:Name="MajBtn" Style="{StaticResource BtnPetitOr}" Margin="8,0,0,0" Visibility="Collapsed" Content="Mettre à jour" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F3ECDF" CornerRadius="14" Padding="4" Margin="22,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OngletAgenda" Style="{StaticResource Onglet}" GroupName="Onglets" Content="Culte" ToolTip="Le déroulé du culte (Ctrl K pour chercher)" />
                            <RadioButton x:Name="OngletBible" Style="{StaticResource Onglet}" GroupName="Onglets" IsChecked="True" Content="Bible" Margin="2,0,0,0" />
                            <RadioButton x:Name="OngletChants" Style="{StaticResource Onglet}" GroupName="Onglets" Content="Chants" Margin="2,0,0,0" />
                            <RadioButton x:Name="OngletAnnonces" Style="{StaticResource Onglet}" GroupName="Onglets" Content="Display" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- recherche : culte (versets et chants, Ctrl K), Bible ou chants selon l'onglet -->
                    <Grid Grid.Column="2" Margin="20,0" MaxWidth="720" HorizontalAlignment="Stretch">
                        <Border x:Name="RechercheCulte" Background="{StaticResource Nuit2}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="13" Padding="14,0,8,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                                <TextBlock x:Name="CmdIndice" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="Jean 3:16, chant 45, ou quelques mots des paroles…" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Cmd" Grid.Column="1" Margin="10,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" />
                                <Border Grid.Column="2" Style="{StaticResource Touche}" Background="{StaticResource Encre}" Margin="8,0,0,0">
                                    <TextBlock Text="Ctrl K" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Popup x:Name="CmdPopup" PlacementTarget="{Binding ElementName=RechercheCulte}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False"
                               Width="{Binding ActualWidth, ElementName=RechercheCulte}">
                            <Border Background="{StaticResource Encre}" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="16" Padding="6" Margin="0,6,0,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#3C280A" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.16" />
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel x:Name="CmdResultats" />
                                    <TextBlock x:Name="CmdAide" Margin="10,6,10,4" FontSize="12" Foreground="{StaticResource Brume}" Text="Entrée : afficher · Tab ou + : ajouter au déroulé · ↑ ↓ : choisir" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Border x:Name="RechercheBible" Background="{StaticResource Nuit2}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="13" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                                <TextBlock x:Name="QIndice" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="jn 3 16 · ps 23 · rm 8.28 · ou des mots, même mal écrits" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Q" Grid.Column="1" Margin="10,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" />
                                <Button x:Name="QEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                            </Grid>
                        </Border>
                        <Border x:Name="RechercheChants" Background="{StaticResource Nuit2}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="13" Padding="14,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                                <TextBlock x:Name="QcIndice" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="Chercher un chant : titre, numéro ou paroles" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="Qc" Grid.Column="1" Margin="10,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" />
                                <Button x:Name="QcEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TelBtn" Style="{StaticResource Btn}" Padding="12,0" Height="44" ToolTip="Télécommande Android">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5,0.5 H11 A2,2 0 0 1 13,2.5 V15.5 A2,2 0 0 1 11,17.5 H5 A2,2 0 0 1 3,15.5 V2.5 A2,2 0 0 1 5,0.5 Z M7,14.5 H9" Stroke="{StaticResource Blanc}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                <Ellipse x:Name="TelPoint" Width="7" Height="7" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="8,1,0,0" />
                                <TextBlock x:Name="TelTexte" Text="Téléphones" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SceneBtn" Style="{StaticResource Btn}" Padding="12,0" Height="44" Margin="8,0,0,0" ToolTip="Écran de scène : l'heure, le minuteur, ce qui est à l'écran et ce qui vient (pour le prédicateur et la chorale)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,1 H18 A1.5,1.5 0 0 1 19.5,2.5 V12 A1.5,1.5 0 0 1 18,13.5 H2 A1.5,1.5 0 0 1 0.5,12 V2.5 A1.5,1.5 0 0 1 2,1 Z M6,17.5 H14 M10,13.5 V17.5" Stroke="{StaticResource Blanc}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                <TextBlock Text="Écran de scène" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProjectionBtn" Style="{StaticResource BtnPlat}" Padding="10,8" Margin="6,0,0,0" ToolTip="Choisir l'écran de projection">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ProjectionPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                <TextBlock x:Name="ProjectionTexte" Text="Projection" FontSize="13" Foreground="{StaticResource Brume}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OutilsBtn" Style="{StaticResource Btn}" Width="44" Height="44" Padding="0" Margin="6,0,0,0" ToolTip="Outils : mise à jour, transfert, journal d'erreurs">
                            <Path Data="M3,5 H11 M15,5 H17 M3,10 H5 M9,10 H17 M3,15 H13 M17,15 H17 M13,3 V7 M7,8 V12 M15,13 V17" Stroke="{StaticResource Blanc}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== colonne de droite : en direct, habillage ==================== -->
            <Border x:Name="Colonne" DockPanel.Dock="Right" Width="400" Background="{StaticResource Page}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,18,22,18">
                        <Border Style="{StaticResource Carte}" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="EcranInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Rouge}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="EN DIRECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Direct}" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Border x:Name="Apercu" BorderBrush="{StaticResource Nuit3}" BorderThickness="1.5" CornerRadius="14" Background="{StaticResource Damier}"
                                            ToolTip="Double-clic : couper cette diapositive" Cursor="Hand">
                                        <Viewbox Stretch="Uniform">
                                            <local:Rendu x:Name="ApercuRendu" Width="1920" Height="1080" Transitions="False" />
                                        </Viewbox>
                                    </Border>
                                    <Border x:Name="Pastille" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="6" Padding="8,2" Background="#D9FFFFFF">
                                        <TextBlock x:Name="PastilleTexte" Text="Écran fermé" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                                    </Border>
                                </Grid>
                                <Border Background="{StaticResource Nuit2}" CornerRadius="12" Padding="12,8,8,8" Margin="0,12,0,0">
                                    <DockPanel>
                                        <Button x:Name="Decouper" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="Découper" FontSize="12" Padding="8,3" IsEnabled="False" Margin="8,0,0,0"
                                                ToolTip="Couper la diapositive suivante en plusieurs (Entrée devant une ligne)" />
                                        <TextBlock Text="SUIVANT" DockPanel.Dock="Left" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource Encre2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <Run x:Name="SuivantLab" FontWeight="Bold" Foreground="{StaticResource Blanc}" /><Run x:Name="SuivantTexte" Text="—" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <Button x:Name="Afficher" Style="{StaticResource BtnOr}" Content="Afficher" FontSize="18" Height="56" Padding="0" Margin="0,12,0,0" ToolTip="Entrée" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="Prec" Style="{StaticResource Btn}" Content="‹ Précédent" Height="44" Padding="0" ToolTip="Flèche gauche" />
                                    <Button x:Name="Suiv" Grid.Column="2" Style="{StaticResource Btn}" Content="Suivant ›" Height="44" Padding="0" ToolTip="Flèche droite ou espace" />
                                </Grid>
                                <Button x:Name="Effacer" Style="{StaticResource BtnRouge}" Content="Retirer de l'écran" Height="44" Padding="0" Margin="0,8,0,0" ToolTip="Échap" />
                            </StackPanel>
                        </Border>

                        <!-- Duo : deux contenus en même temps (un contenu épinglé dans un coin, ou côte à côte) -->
                        <Border Style="{StaticResource Carte}" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="DuoEtat" DockPanel.Dock="Right" Text="rien d'épinglé" FontSize="12" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                                    <TextBlock Text="DUO" Style="{StaticResource CarteTitre}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="DuoAide" Text="Deux contenus en même temps : affichez le premier, épinglez-le, puis affichez le second." FontSize="12" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Border x:Name="DuoBoite" Background="{StaticResource Nuit2}" CornerRadius="12" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock Text="ÉPINGLÉ" DockPanel.Dock="Left" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="DuoLibelle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Blanc}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Button x:Name="DuoEpingler" Style="{StaticResource BtnOr}" Content="Épingler ce qui est à l'écran" Height="44" Padding="0" ToolTip="Touche P · ce qui est à l'écran part dans le coin, l'écran se libère pour autre chose" />
                                <Button x:Name="DuoRetirer" Style="{StaticResource Btn}" Content="Retirer le duo" Height="44" Padding="0" Margin="0,8,0,0" IsEnabled="False" ToolTip="Touche P · retire seulement le contenu épinglé" />
                                <DockPanel Margin="0,12,0,0">
                                    <ComboBox x:Name="DuoPlace" DockPanel.Dock="Right" Width="150" ToolTip="Place du contenu épinglé">
                                        <ComboBoxItem Tag="hd" Content="Haut droite" />
                                        <ComboBoxItem Tag="hg" Content="Haut gauche" />
                                        <ComboBoxItem Tag="bd" Content="Bas droite" />
                                        <ComboBoxItem Tag="bg" Content="Bas gauche" />
                                        <ComboBoxItem Tag="cote" Content="Côte à côte" />
                                    </ComboBox>
                                    <TextBlock Text="Place" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Encre2}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="DuoTailleLab" Text="Taille du contenu épinglé : 35 %" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Encre2}" Margin="0,12,0,4" />
                                <Slider x:Name="DuoTaille" Minimum="20" Maximum="50" SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" Value="35" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Carte}" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="HABILLAGE DE L'ÉCRAN" Style="{StaticResource CarteTitre}" Margin="0,0,0,10" />
                                <WrapPanel x:Name="Fonds" />
                                <DockPanel Margin="0,10,0,0">
                                    <ComboBox x:Name="Presentation" DockPanel.Dock="Right" Width="150" ToolTip="Présentation">
                                        <ComboBoxItem Tag="plein" Content="Plein écran" />
                                        <ComboBoxItem Tag="bandeau" Content="En bandeau" />
                                    </ComboBox>
                                    <TextBlock Text="Présentation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Encre2}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Taille du texte" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Encre2}" Margin="0,12,0,4" />
                                <Slider x:Name="Taille" Minimum="0.6" Maximum="1.2" SmallChange="0.05" LargeChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" />

                                <!-- minuteur de prédication -->
                                <Border Background="{StaticResource Nuit2}" CornerRadius="14" Padding="12" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M11,5 A8,8 0 1 1 10.99,5 Z M11,9 V13 L13.5,15 M8,1.5 H14" Stroke="{StaticResource Or}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Width="22" Height="22" Stretch="None" />
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="Minuteur de prédication" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Visible sur l'écran de scène" FontSize="12" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock x:Name="MinuteurTemps" Grid.Column="2" FontSize="24" FontWeight="Bold" Text="45:00" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0" Height="4">
                                            <Border Background="#EDE3D1" CornerRadius="2" />
                                            <Border x:Name="MinuteurBarre" Background="{StaticResource OrVif}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="MinuteurBtn" Style="{StaticResource BtnPetit}" Content="Démarrer" MinWidth="96" />
                                            <Button x:Name="MinuteurZero" Style="{StaticResource BtnPetit}" Content="Remettre à zéro" Margin="6,0,0,0" />
                                            <ComboBox x:Name="MinuteurDuree" Width="92" Margin="6,0,0,0" ToolTip="Durée prévue">
                                                <ComboBoxItem Tag="20" Content="20 min" />
                                                <ComboBoxItem Tag="30" Content="30 min" />
                                                <ComboBoxItem Tag="35" Content="35 min" />
                                                <ComboBoxItem Tag="40" Content="40 min" />
                                                <ComboBoxItem Tag="45" Content="45 min" IsSelected="True" />
                                                <ComboBoxItem Tag="60" Content="60 min" />
                                                <ComboBoxItem Tag="90" Content="90 min" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="RACCOURCIS" Style="{StaticResource CarteTitre}" Margin="0,18,0,8" />
                                <WrapPanel x:Name="Aide" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="Centre">
                <!-- ==================== culte : déroulé (à gauche) et élément en cours (au centre) ==================== -->
                <Grid x:Name="PanneauAgenda" Margin="22,18,18,18" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColonneAgenda" Width="360" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Carte}" Padding="18">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="AgendaProgres" DockPanel.Dock="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brume}" VerticalAlignment="Bottom" Margin="8,0,0,6" />
                                <StackPanel>
                                    <TextBlock Text="DÉROULÉ DU CULTE" Style="{StaticResource CarteTitre}" />
                                    <DockPanel Margin="0,2,0,0">
                                        <Button x:Name="AgendaMenu" DockPanel.Dock="Right" Style="{StaticResource BtnPlat}" Padding="8,8" VerticalAlignment="Center" ToolTip="Changer de culte, nouveau, renommer, supprimer">
                                            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Brume}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Button>
                                        <TextBlock x:Name="AgendaTitre" FontFamily="{StaticResource UiTitre}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="AgendaPiste" DockPanel.Dock="Top" Height="6" Margin="0,12,0,12">
                                <Border Background="#F1E9DA" CornerRadius="3" />
                                <Border x:Name="AgendaBarre" Background="{StaticResource OrVif}" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Rectangle RadiusX="12" RadiusY="12" Stroke="#D9CBB1" StrokeDashArray="4 3" StrokeThickness="1" Fill="#FFFDF9" IsHitTestVisible="False" />
                                    <Button x:Name="AgendaAjouter" Style="{StaticResource Btn}" Background="Transparent" BorderBrush="Transparent" Content="+ Ajouter" Height="44" Padding="0" ToolTip="Ajouter un chant, un passage, une display, un compte à rebours" />
                                </Grid>
                                <Button x:Name="AgendaPartager" Grid.Column="2" Style="{StaticResource Btn}" Height="44" Padding="0" ToolTip="Envoyer le déroulé sur WhatsApp">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14,1.5 A2.5,2.5 0 1 1 13.99,1.5 Z M4,7.5 A2.5,2.5 0 1 1 3.99,7.5 Z M14,13.5 A2.5,2.5 0 1 1 13.99,13.5 Z M6.2,8.8 L11.8,5.2 M6.2,11.2 L11.8,14.8" Stroke="{StaticResource Blanc}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Partager" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="ListeAgenda" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleAgenda}" />
                                <TextBlock x:Name="AgendaVide" Margin="6,8,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" IsHitTestVisible="False" LineHeight="22"
                                           Text="Le déroulé est vide. « + Ajouter » ou cherchez en haut (Ctrl K) : « chant 12 », « jean 3 16 »… puis Tab. Les boutons + de Bible, Chants et Display ajoutent aussi ici." />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Carte}" Padding="16,12" Margin="0,14,0,0">
                            <DockPanel>
                                <Button x:Name="ResumePartager" DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="44" Padding="14,0" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Envoyer le résumé du culte sur WhatsApp">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14,1.5 A2.5,2.5 0 1 1 13.99,1.5 Z M4,7.5 A2.5,2.5 0 1 1 3.99,7.5 Z M14,13.5 A2.5,2.5 0 1 1 13.99,13.5 Z M6.2,8.8 L11.8,5.2 M6.2,11.2 L11.8,14.8" Stroke="{StaticResource Blanc}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Partager sur WhatsApp" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="RÉSUMÉ DU CULTE" Style="{StaticResource CarteTitre}" />
                                    <TextBlock x:Name="ResumeTexte" FontSize="13.5" Foreground="{StaticResource Encre2}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Text="Rien n'a encore été affiché." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock x:Name="ElemType" Style="{StaticResource CarteTitre}" />
                            <TextBlock x:Name="ElemTitre" FontFamily="{StaticResource UiTitre}" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="Préparez le culte" />
                            <WrapPanel x:Name="ElemBoutons" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel x:Name="ElemVersions" Orientation="Horizontal" VerticalAlignment="Center" />
                                <Button x:Name="ElemAfficher" Style="{StaticResource BtnPetitOr}" Content="Afficher depuis le début" Margin="0,0,8,0" />
                                <Button x:Name="ElemModifier" Style="{StaticResource BtnPetit}" Content="Modifier" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="DefilDiapos" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <WrapPanel x:Name="Diapos" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ==================== displays : la bibliothèque ==================== -->
                <Grid x:Name="PanneauAnnonces" Margin="22,18,18,18" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColonneAnnonces" Width="360" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Carte}" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="DISPLAY" Style="{StaticResource CarteTitre}" />
                                <TextBlock Text="Bibliothèque" FontFamily="{StaticResource UiTitre}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,12" />
                                <Button x:Name="DisplayAjouter" Style="{StaticResource BtnOr}" Height="44" Padding="14,0" ToolTip="Ajouter un texte, des images ou une source vidéo">
                                    <Grid>
                                        <TextBlock Text="+ Ajouter une source" VerticalAlignment="Center" Margin="0,0,26,0" />
                                        <Path Data="M1,1 L6,6 L11,1" Stroke="{StaticResource SurOr}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <TextBlock Text="+ : ajouter à la grille · double-clic : en direct · clic droit : autres actions." TextWrapping="Wrap" Foreground="{StaticResource Brume}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <ListBox x:Name="ListeAnnonces" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleAnnonce}" />
                                <TextBlock x:Name="AnnoncesVide" Margin="6,8,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" IsHitTestVisible="False" LineHeight="22"
                                           Text="Ajoutez un texte, une image, un périphérique vidéo ou une capture de fenêtre." />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="GRILLE · UN CLIC = EN DIRECT" Style="{StaticResource CarteTitre}" />
                                <TextBlock x:Name="GrilleInfo" FontSize="12" Foreground="{StaticResource Brume}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Visibility="Collapsed">
                                <TextBlock Text="TITRE" Style="{StaticResource CarteTitre}" />
                                <TextBox x:Name="AnnonceTitre" Style="{StaticResource Champ}" Margin="0,6,0,14" FontSize="17" />
                                <TextBlock x:Name="DisplaySourceInfo" Text="Texte : une ligne vide entre deux diapositives" Style="{StaticResource CarteTitre}" />
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="Collapsed">
                                <Button x:Name="DisplayReconnecter" Visibility="Collapsed" Style="{StaticResource Btn}" Content="Reconnecter la source en direct" Padding="18,10" Margin="0,0,8,6" />
                                <Button x:Name="AnnonceEnregistrer" Style="{StaticResource BtnOr}" Content="Enregistrer" Padding="18,10" Margin="0,0,8,6" />
                                <Button x:Name="AnnonceAfficher" Style="{StaticResource Btn}" Content="Afficher" Padding="18,10" Margin="0,0,8,6" />
                                <Button x:Name="AnnonceAjouter" Style="{StaticResource Btn}" Content="+ Déroulé du culte" Padding="18,10" Margin="0,0,8,6" />
                                <Button x:Name="AnnonceSupprimer" Style="{StaticResource BtnRouge}" Content="Supprimer" Padding="18,10" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBox x:Name="AnnonceTexte" DockPanel.Dock="Bottom" Visibility="Collapsed" Style="{StaticResource Zone}" Margin="0,6,0,0" FontSize="16" />
                            <Grid>
                                <ScrollViewer x:Name="DefilGrille" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="GrilleSources" />
                                </ScrollViewer>
                                <TextBlock x:Name="GrilleVide" TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="{StaticResource Brume}" IsHitTestVisible="False" Margin="4,6,4,0"
                                           Text="La grille est vide. Cliquez le + devant un titre à gauche pour l'ajouter ici. Ensuite, un seul clic sur une tuile l'envoie en direct sur l'écran choisi." />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ==================== Bible ==================== -->
                <Grid x:Name="PanneauBible" Margin="22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColonneCote" Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                        <StackPanel>
                            <Border Style="{StaticResource Carte}">
                                <StackPanel>
                                    <TextBlock Text="BIBLES" Style="{StaticResource CarteTitre}" />
                                    <StackPanel x:Name="BiblesChoix" Margin="0,6,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Trait2}" StrokeDashArray="4 3" StrokeThickness="1" IsHitTestVisible="False" />
                                        <Button x:Name="BiblesImporter" Style="{StaticResource Btn}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Or}" Padding="10" Content="+ Importer une Bible" />
                                    </Grid>
                                    <TextBlock x:Name="BiblesEtat" Style="{StaticResource MuetPetit}" Margin="0,8,0,0">
                                        <Run Text="Cliquez une Bible pour l'afficher ·" /> <Run Text="2e" FontWeight="Bold" /> <Run Text="= versets bilingues (sous le verset)" />
                                    </TextBlock>
                                    <Button x:Name="BiblesGerer" Style="{StaticResource BtnLien}" Content="Gérer les Bibles…" Margin="0,8,0,0" ToolTip="Supprimer une Bible, choisir dans une liste" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Carte}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ANCIEN TESTAMENT" Style="{StaticResource CarteTitre}" Margin="0,0,0,6" />
                                    <UniformGrid x:Name="LivresAT" Columns="3" />
                                    <TextBlock Text="NOUVEAU TESTAMENT" Style="{StaticResource CarteTitre}" Margin="0,12,0,6" />
                                    <UniformGrid x:Name="LivresNT" Columns="3" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" MinHeight="38" Margin="0,0,0,10" LastChildFill="False">
                                <Button x:Name="AgendaAjoutBible" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="+ Agenda" Margin="10,0,0,0" ToolTip="Ajouter les versets choisis (ou le chapitre) à l'agenda" VerticalAlignment="Center" />
                                <TextBlock x:Name="VersionsLab" DockPanel.Dock="Right" Style="{StaticResource Muet}" VerticalAlignment="Center" Text="Version : LSG" Margin="12,0,0,0" TextWrapping="NoWrap" />
                                <Button x:Name="ChapPrec" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="‹" ToolTip="Chapitre précédent" Visibility="Collapsed" VerticalAlignment="Center" />
                                <TextBlock x:Name="TitreChap" DockPanel.Dock="Left" Style="{StaticResource Titre2}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ChapSuiv" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="›" ToolTip="Chapitre suivant" Visibility="Collapsed" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer x:Name="DefilVersets" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <StackPanel x:Name="Versets" MaxWidth="1300" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ==================== chants ==================== -->
                <Grid x:Name="PanneauChants" Margin="22,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button x:Name="SupprimerRecueil" DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Supprimer" Margin="8,0,0,0" ToolTip="Supprimer ce recueil et ses chants" />
                            <ComboBox x:Name="Recueil" ToolTip="Recueil" MaxDropDownHeight="520" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                            <Button x:Name="Importer" Style="{StaticResource BtnOr}" Content="+ Importer chants / recueil"
                                    ToolTip="Ajouter des chants ou un recueil : VideoPsalm, OpenLyrics, OpenSong, ChordPro, SongSelect, ProPresenter 6, PDF, texte collé, lien d'un site" />
                            <Button x:Name="Nouveau" Style="{StaticResource Btn}" Content="+ Nouveau chant" Margin="0,8,0,0"
                                    ToolTip="Taper ou coller un chant : il est rangé tout seul en diapositives" />
                        </StackPanel>
                        <Border x:Name="NumBoite" DockPanel.Dock="Top" Margin="0,0,0,8" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10" Padding="12,0,4,0"
                                ToolTip="Taper le numéro du chant dans ce recueil (Entrée : ouvrir, puis 1-9 pour les strophes)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="N°" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" />
                                <TextBlock x:Name="NumIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                           Text="Numéro du chant" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="NumChant" Grid.Column="1" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}" MaxLength="6"
                                         CaretBrush="{StaticResource Or}" SelectionBrush="{StaticResource Or}" VerticalContentAlignment="Center" Padding="0,8" FocusVisualStyle="{x:Null}" InputMethod.IsInputMethodEnabled="False" />
                                <Button x:Name="NumEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,2" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer le numéro" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ListBox x:Name="ListeChants" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleChant}" />
                            <TextBlock x:Name="ListeVide" Margin="6,14,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="ChantTitre" Style="{StaticResource Titre2}" Text="Aucun chant choisi" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AgendaAjoutChant" Style="{StaticResource BtnPetit}" Content="+ Agenda" IsEnabled="False" ToolTip="Ajouter ce chant à l'agenda" />
                                <Button x:Name="Modifier" Style="{StaticResource BtnPetit}" Content="Modifier" IsEnabled="False" Margin="8,0,0,0" />
                                <Button x:Name="Supprimer" Style="{StaticResource BtnDanger}" Content="Supprimer" IsEnabled="False" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="DefilSections" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="Sections" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- message court -->
        <Border x:Name="ToastBoite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Background="{StaticResource Blanc}" BorderThickness="0"
                CornerRadius="12" Padding="18,10" MaxWidth="900" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastTexte" TextWrapping="Wrap" Foreground="White" />
        </Border>
    </Grid>
</Window>
