<local:FenetreDialogue x:Class="MyVerse.Ui.BiblesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Bibles" Width="720" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Bibles" Style="{StaticResource Titre2}" Margin="0,0,0,14" />
        <TextBlock Text="Version principale" Style="{StaticResource Etiquette}" />
        <ComboBox x:Name="Principale" />
        <TextBlock Text="2e version (affichée sous le verset : versets bilingues)" Style="{StaticResource Etiquette}" Margin="0,14,0,6" />
        <ComboBox x:Name="Seconde" />
        <TextBlock Text="Vos Bibles" Style="{StaticResource SousTitre}" Margin="0,18,0,8" />
        <StackPanel x:Name="Liste" />
        <Button x:Name="Importer" Style="{StaticResource BtnOr}" Content="Importer une Bible…" HorizontalAlignment="Left" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Muet}" Margin="0,12,0,0"
                   Text="Formats acceptés : Zefania XML, OSIS XML, USFX, JSON, ou texte (une ligne par verset : « Genèse 1:1 Au commencement… »). Toutes les langues (kirundi, swahili, anglais…) : les livres sont rangés dans l'ordre de la Bible." />
        <TextBlock x:Name="Etat" Style="{StaticResource Muet}" FontSize="14" Margin="0,10,0,0" MinHeight="20" />
        <Button x:Name="Fermer" Style="{StaticResource Btn}" Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Margin="0,8,0,0" IsCancel="True" />
    </StackPanel>
</local:FenetreDialogue>
