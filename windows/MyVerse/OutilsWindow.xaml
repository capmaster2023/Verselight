<local:FenetreDialogue x:Class="MyVerse.Ui.OutilsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Outils" Width="820" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Outils" Style="{StaticResource Titre2}" Margin="0,0,0,6" />
        <TextBlock Text="Mise à jour" Style="{StaticResource SousTitre}" />
        <TextBlock x:Name="MajEtat" Style="{StaticResource Muet}" FontSize="14" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="Verifier" Style="{StaticResource Btn}" Content="Rechercher une mise à jour" />
            <Button x:Name="Installer" Style="{StaticResource BtnOr}" Content="Installer la mise à jour" Margin="10,0,0,0" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muet}" Margin="0,8,0,0" Text="L'installation ferme MyChurch quelques secondes puis le rouvre. Chants, réglages et téléphones jumelés sont gardés." />
        <TextBlock Text="Transférer vers un autre ordinateur" Style="{StaticResource SousTitre}" Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource Muet}" FontSize="14" TextWrapping="Wrap"
                   Text="Exportez vos Bibles importées et vos chants dans un seul fichier .myverse (clé USB, courriel…). Sur l'autre ordinateur : Outils → Importer un fichier MyChurch." />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ExporterBibles" Style="{StaticResource Btn}" Content="Exporter les Bibles" />
            <Button x:Name="ExporterChants" Style="{StaticResource Btn}" Content="Exporter les chants" Margin="10,0,0,0" />
            <Button x:Name="ExporterTout" Style="{StaticResource Btn}" Content="Exporter tout" Margin="10,0,0,0" />
            <Button x:Name="ImporterFichier" Style="{StaticResource BtnOr}" Content="Importer un fichier MyChurch" Margin="24,0,0,0" />
        </StackPanel>
        <TextBlock Text="Journal d'erreurs" Style="{StaticResource SousTitre}" Margin="0,16,0,6" />
        <TextBox x:Name="JournalTexte" Height="200" IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="12" TextWrapping="NoWrap"
                 Background="{StaticResource Nuit2}" Foreground="{StaticResource Blanc}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" Padding="8"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="Actualiser" Style="{StaticResource Btn}" Content="Actualiser" />
            <Button x:Name="Copier" Style="{StaticResource BtnOr}" Content="Copier le journal" Margin="10,0,0,0" />
            <Button x:Name="Vider" Style="{StaticResource Btn}" Content="Vider" Margin="10,0,0,0" />
            <Button x:Name="Dossier" Style="{StaticResource Btn}" Content="Ouvrir le dossier des données" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="Aide" Style="{StaticResource Muet}" Margin="0,8,0,0" />
        <Button x:Name="Fermer" Style="{StaticResource Btn}" Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Margin="0,14,0,0" IsCancel="True" />
    </StackPanel>
</local:FenetreDialogue>
