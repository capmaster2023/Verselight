<local:FenetreDialogue x:Class="MyVerse.Ui.OutilsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Paramètres" Width="900" Height="780" MinWidth="720" MinHeight="480" ResizeMode="CanResize"
        Background="{StaticResource Page}">
    <DockPanel>
        <!-- en-tête : titre et Fermer, toujours visibles -->
        <DockPanel DockPanel.Dock="Top" Margin="28,22,28,14">
            <Button x:Name="Fermer" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Fermer" Height="40" Padding="16,0" FontSize="14" IsCancel="True" />
            <TextBlock Text="Paramètres" FontFamily="{StaticResource Grotesk}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,22,12">
            <StackPanel>
                <!-- Périphériques audio, MyVirtualSound, Enregistrement, Code source et licences : construits en C# (Audio/AudioSettingsPanel.cs) -->
                <ContentControl x:Name="AudioSections" Focusable="False" />

                <!-- mise à jour -->
                <Border Style="{StaticResource Section}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="Installer" Style="{StaticResource BtnOr}" Content="Installer la mise à jour" Height="40" Padding="14,0" FontSize="14" Margin="0,0,10,0" Visibility="Collapsed"
                                    ToolTip="L'installation ferme MyChurch quelques secondes puis le rouvre. Chants, réglages et téléphones jumelés sont gardés." />
                            <Button x:Name="Verifier" Style="{StaticResource Btn}" Content="Rechercher une mise à jour" Height="40" Padding="14,0" FontSize="14" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Mise à jour" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="MajEtat" FontSize="13" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- transfert -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Transférer vers un autre ordinateur" Style="{StaticResource SousTitre}" Margin="0" />
                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource Encre2}" Margin="0,8,0,0" LineHeight="20"
                                   Text="Exportez vos Bibles importées et vos chants dans un seul fichier .myverse (clé USB, courriel…). Sur l'autre ordinateur : Paramètres → Importer un fichier MyChurch." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ExporterBibles" Style="{StaticResource Btn}" Content="Exporter les Bibles" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="ExporterChants" Style="{StaticResource Btn}" Content="Exporter les chants" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="ExporterTout" Style="{StaticResource Btn}" Content="Exporter tout" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="ImporterFichier" Style="{StaticResource BtnOr}" Content="Importer un fichier MyChurch" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- journal d'erreurs -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Journal d'erreurs" Style="{StaticResource SousTitre}" Margin="0,0,0,10" />
                        <TextBox x:Name="JournalTexte" Height="200" IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="12" TextWrapping="NoWrap"
                                 Background="{StaticResource Nuit2}" Foreground="{StaticResource Blanc}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" Padding="8"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="Actualiser" Style="{StaticResource Btn}" Content="Actualiser" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="Copier" Style="{StaticResource BtnOr}" Content="Copier le journal" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="Vider" Style="{StaticResource Btn}" Content="Vider" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                            <Button x:Name="Dossier" Style="{StaticResource Btn}" Content="Ouvrir le dossier des données" Height="40" Padding="14,0" FontSize="14" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="Aide" Style="{StaticResource Muet}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:FenetreDialogue>
