<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MyVerse.Ui">
    <!-- ===================== couleurs de MyChurch 3.1 : clair par défaut, sombre au choix (Réglages › Apparence) ===================== -->
    <!-- Chaque pinceau suit Palette.Actuelle (Palette.cs) : changer de thème met à jour toute l'interface d'un coup.
         Les noms viennent des versions précédentes : « Blanc » est le texte, « Encre » et « Nuit » le fond des cartes, « Or » l'accent (ambre). -->
    <SolidColorBrush x:Key="Page" Color="{Binding Page, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Rail" Color="{Binding Rail, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="RailActif" Color="{Binding RailActif, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Encre" Color="{Binding Encre, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Nuit" Color="{Binding Nuit, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Nuit2" Color="{Binding Nuit2, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Nuit3" Color="{Binding Nuit3, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Trait" Color="{Binding Trait, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Trait2" Color="{Binding Trait2, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Blanc" Color="{Binding Blanc, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Encre2" Color="{Binding Encre2, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Brume" Color="{Binding Brume, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Brume2" Color="{Binding Brume2, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Or" Color="{Binding Or, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Or2" Color="{Binding Or2, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="OrVif" Color="{Binding OrVif, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="OrLeger" Color="{Binding OrLeger, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="SurOr" Color="{Binding SurOr, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="OrDegrade" Color="{Binding OrDegrade, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="OrDegradeClair" Color="{Binding OrDegradeClair, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Rouge" Color="{Binding Rouge, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Direct" Color="{Binding Direct, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="RougeLeger" Color="{Binding RougeLeger, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="RougeBord" Color="{Binding RougeBord, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="RougeTexte" Color="{Binding RougeTexte, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Danger" Color="{Binding Danger, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Vert" Color="{Binding Vert, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="VertLeger" Color="{Binding VertLeger, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="BleuFonce" Color="{Binding BleuFonce, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Marque" Color="{Binding Marque, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="Surligne" Color="{Binding Surligne, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="TuileFond" Color="{Binding TuileFond, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="TuileSource" Color="{Binding TuileSource, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="TuileTexte" Color="{Binding TuileTexte, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="VuFond" Color="{Binding VuFond, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="VuCrete" Color="{Binding VuCrete, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="DamierA" Color="{Binding DamierA, Source={x:Static local:Palette.Actuelle}}" />
    <SolidColorBrush x:Key="DamierB" Color="{Binding DamierB, Source={x:Static local:Palette.Actuelle}}" />
    <!-- damier : rien à l'écran (transparent), comme la sortie -->
    <DrawingBrush x:Key="Damier" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource DamierA}" Geometry="M0,0 H2 V2 H0 Z" />
                <GeometryDrawing Brush="{StaticResource DamierB}" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== icônes (traits de 24 × 24) ===================== -->
    <Geometry x:Key="IconeCulte">M9,6 H20 M9,12 H20 M9,18 H20 M4.5,6 H4.6 M4.5,12 H4.6 M4.5,18 H4.6</Geometry>
    <Geometry x:Key="IconeBible">M4,19.5 V5 A2,2 0 0 1 6,3 H20 V17 H6 A2,2 0 0 0 4,19 A2,2 0 0 0 6,21 H20 M9,7 H16</Geometry>
    <Geometry x:Key="IconeChants">M9,18 V5 L21,3 V16 M3,18 A3,3 0 1 0 9,18 A3,3 0 1 0 3,18 M15,16 A3,3 0 1 0 21,16 A3,3 0 1 0 15,16</Geometry>
    <Geometry x:Key="IconeDisplay">M5.5,4 H9.5 A1.5,1.5 0 0 1 11,5.5 V9.5 A1.5,1.5 0 0 1 9.5,11 H5.5 A1.5,1.5 0 0 1 4,9.5 V5.5 A1.5,1.5 0 0 1 5.5,4 Z M14.5,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V9.5 A1.5,1.5 0 0 1 18.5,11 H14.5 A1.5,1.5 0 0 1 13,9.5 V5.5 A1.5,1.5 0 0 1 14.5,4 Z M5.5,13 H9.5 A1.5,1.5 0 0 1 11,14.5 V18.5 A1.5,1.5 0 0 1 9.5,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V14.5 A1.5,1.5 0 0 1 5.5,13 Z M14.5,13 H18.5 A1.5,1.5 0 0 1 20,14.5 V18.5 A1.5,1.5 0 0 1 18.5,20 H14.5 A1.5,1.5 0 0 1 13,18.5 V14.5 A1.5,1.5 0 0 1 14.5,13 Z</Geometry>
    <Geometry x:Key="IconeDuo">M5,5 H13 A2,2 0 0 1 15,7 V13 A2,2 0 0 1 13,15 H5 A2,2 0 0 1 3,13 V7 A2,2 0 0 1 5,5 Z M15,9 H19 A2,2 0 0 1 21,11 V17 A2,2 0 0 1 19,19 H11 A2,2 0 0 1 9,17 V15</Geometry>
    <Geometry x:Key="IconeReglages">M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H15 M19,18 H20 M15,4 A2,2 0 1 1 15,8 A2,2 0 1 1 15,4 Z M9,10 A2,2 0 1 1 9,14 A2,2 0 1 1 9,10 Z M17,16 A2,2 0 1 1 17,20 A2,2 0 1 1 17,16 Z</Geometry>
    <Geometry x:Key="IconePartager">M18,2.5 A2.5,2.5 0 1 1 17.99,2.5 Z M6,9.5 A2.5,2.5 0 1 1 5.99,9.5 Z M18,16.5 A2.5,2.5 0 1 1 17.99,16.5 Z M8.3,10.8 L15.7,6.4 M8.3,13.2 L15.7,17.6</Geometry>
    <Geometry x:Key="IconePlus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="IconeCoche">M5,12.5 L9.5,17 L19,7.5</Geometry>

    <!-- ===================== polices (incluses dans MyChurch) : projection (Literata, Atkinson, Unbounded), interface (Inter, Space Grotesk) ===================== -->
    <FontFamily x:Key="Serif">./Polices/#Literata, Georgia</FontFamily>
    <FontFamily x:Key="Sans">./Polices/#Atkinson Hyperlegible Next, Segoe UI</FontFamily>
    <FontFamily x:Key="Titre">./Polices/#Unbounded, Segoe UI</FontFamily>
    <FontFamily x:Key="Ui">./Polices/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="UiTitre">./Polices/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Grotesk">./Polices/#Space Grotesk, Segoe UI</FontFamily>
    <!-- heures, durées, étapes : chiffres à chasse fixe (polices de Windows) -->
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== focus clavier : contour ambre ===================== -->
    <Style x:Key="FocusOr">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{StaticResource OrVif}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== textes ===================== -->
    <Style x:Key="TexteBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Muet" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="Foreground" Value="{StaticResource Brume}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="MuetPetit" TargetType="TextBlock" BasedOn="{StaticResource Muet}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- petite étiquette en capitales grises : BIBLIOTHÈQUE, MÉLANGEUR, ENREGISTREMENTS… (espacées par Capitales.Espacer) -->
    <Style x:Key="CarteTitre" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brume}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- titre de l'en-tête de page : « Culte du dimanche 15 novembre », « Display », « Réglages » -->
    <Style x:Key="TitrePage" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontFamily" Value="{StaticResource Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="21" />
    </Style>
    <!-- grand titre dans une page : « Grille », « Audio », « Jean 3 » -->
    <Style x:Key="GrandTitre" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontFamily" Value="{StaticResource Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="Titre2" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontFamily" Value="{StaticResource Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
    </Style>
    <Style x:Key="SousTitre" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <!-- titre d'une carte : Duo, Habillage de l'écran -->
    <Style x:Key="TitreCarte" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Etiquette" TargetType="TextBlock" BasedOn="{StaticResource TexteBase}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================== boutons ===================== -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Trait2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- bouton principal : ambre, texte foncé (Suivant, + Ajouter une source, + Source audio) -->
    <Style x:Key="BtnOr" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource OrDegrade}" />
        <Setter Property="Foreground" Value="{StaticResource SurOr}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OrDegradeClair}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Retirer de l'écran, Supprimer -->
    <Style x:Key="BtnRouge" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource RougeLeger}" />
        <Setter Property="BorderBrush" Value="{StaticResource RougeBord}" />
        <Setter Property="Foreground" Value="{StaticResource RougeTexte}" />
    </Style>
    <!-- bouton encadré : Épingler, Afficher la sélection, Lire la licence -->
    <Style x:Key="BtnContour" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="{StaticResource Blanc}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BtnPetit" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="BtnPetitOr" TargetType="Button" BasedOn="{StaticResource BtnOr}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPetit}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <!-- pastille de l'en-tête : Téléphone, Écran de scène, ● Écran 2 · 1920×1080 -->
    <Style x:Key="Pilule" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BtnLien" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Or2}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" Background="Transparent" TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Blanc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- bouton sans cadre (menus, icônes) -->
    <Style x:Key="BtnPlat" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- petit « + » devant un chant ou un verset : ajouter au déroulé -->
    <Style x:Key="BtnAjout" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Or}" />
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Ajouter au déroulé" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Path Data="M0,5 H10 M5,0 V10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource OrLeger}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- « + » d'une source de la bibliothèque Display : l'ajouter à la grille (✓ quand elle y est) -->
    <Style x:Key="BtnGrille" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Or}" />
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource OrLeger}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- barre de gauche : une page (icône dans Tag, nom dessous) -->
    <Style x:Key="OngletRail" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brume}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="10,0,10,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fond" Background="Transparent" CornerRadius="12" Padding="0,10,0,9">
                        <StackPanel HorizontalAlignment="Center">
                            <Path x:Name="Icone" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blanc}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource RailActif}" />
                            <Setter Property="Foreground" Value="{StaticResource Blanc}" />
                            <Setter TargetName="Icone" Property="Stroke" Value="{StaticResource Or}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- sommaire des Réglages : Apparence, Audio, MyVirtualSound… (barre ambre à gauche de la section en cours) -->
    <Style x:Key="Sommaire" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Encre2}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="14,10,12,10">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <Border x:Name="Barre" Width="3" CornerRadius="2" Background="{StaticResource OrVif}" HorizontalAlignment="Left" Margin="0,9" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Encre}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Nuit3}" />
                            <Setter TargetName="Barre" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Blanc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- anciens onglets (gardés pour d'autres fenêtres) -->
    <Style x:Key="Onglet" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Encre2}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fond" Background="Transparent" CornerRadius="10" Padding="16,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blanc}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Blanc}" />
                            <Setter Property="Foreground" Value="{StaticResource Encre}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- livres de la Bible -->
    <Style x:Key="BtnLivre" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Background" Value="{StaticResource Nuit2}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit3}" />
                            <Setter Property="Foreground" Value="{StaticResource Blanc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnLivreOn" TargetType="Button" BasedOn="{StaticResource BtnLivre}">
        <Setter Property="Background" Value="{StaticResource OrLeger}" />
        <Setter Property="Foreground" Value="{StaticResource Or}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ===================== champs ===================== -->
    <Style x:Key="Champ" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CaretBrush" Value="{StaticResource Blanc}" />
        <Setter Property="SelectionBrush" Value="{StaticResource OrVif}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- grande zone de texte (paroles, journal) -->
    <Style x:Key="Zone" TargetType="TextBox" BasedOn="{StaticResource Champ}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CaretBrush" Value="{StaticResource Blanc}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== case à cocher ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Boite" Width="20" Height="20" CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource Brume2}" Background="{StaticResource Encre}" VerticalAlignment="Center">
                            <Path x:Name="Coche" Data="M3,9 L7,13 L15,4" Stroke="{StaticResource SurOr}" StrokeThickness="2.4" Visibility="Collapsed" Margin="0,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Boite" Property="Background" Value="{StaticResource OrVif}" />
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource OrVif}" />
                            <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== bouton radio (un choix parmi plusieurs) ===================== -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Rond" Width="20" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Brume2}" Background="{StaticResource Encre}" VerticalAlignment="Center">
                            <Ellipse x:Name="Point" Width="8" Height="8" Fill="{StaticResource SurOr}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rond" Property="Background" Value="{StaticResource OrVif}" />
                            <Setter TargetName="Rond" Property="BorderBrush" Value="{StaticResource OrVif}" />
                            <Setter TargetName="Point" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== interrupteur (filtres, sorties MyVirtualSound) ===================== -->
    <Style x:Key="Interrupteur" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Piste" Width="42" Height="24" CornerRadius="12" Background="{StaticResource Trait2}" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Bouton" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Piste" Property="Background" Value="{StaticResource OrVif}" />
                            <Setter TargetName="Bouton" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bouton" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== barres de défilement fines ===================== -->
    <Style x:Key="PouceDefil" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="P" CornerRadius="4" Background="{StaticResource Trait2}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="P" Property="Background" Value="{StaticResource Brume2}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="P" Property="Background" Value="{StaticResource Brume}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PageDefil" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PageDefil}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PouceDefil}" Margin="2,2" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PageDefil}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PageDefil}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PouceDefil}" Margin="2,2" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PageDefil}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== curseur (taille du texte, volumes) ===================== -->
    <Style x:Key="PouceCurseur" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="16" Height="16" Fill="{StaticResource Encre}" Stroke="{StaticResource OrVif}" StrokeThickness="2.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Trait}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{StaticResource OrVif}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PouceCurseur}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource PageDefil}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== fader vertical du mélangeur (comme OBS) ===================== -->
    <Style x:Key="PouceFader" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Width="26" Height="14" CornerRadius="4" Background="{StaticResource Encre}" BorderBrush="{StaticResource Blanc}" BorderThickness="2">
                        <Border Height="2" Margin="5,0" Background="{StaticResource Blanc}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CurseurVertical" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Width="28" Background="Transparent">
                        <Border Width="6" CornerRadius="3" Background="{StaticResource Trait}" HorizontalAlignment="Center" Margin="0,7" />
                        <Track x:Name="PART_Track" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Width="6" CornerRadius="3" Background="{StaticResource OrVif}" HorizontalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PouceFader}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource PageDefil}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== liste déroulante ===================== -->
    <Style x:Key="BoutonListe" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Cadre" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Brume}" StrokeThickness="1.6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Trait2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOr}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Bascule" Style="{StaticResource BoutonListe}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="Choix" IsHitTestVisible="False" Margin="14,6,32,6" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border x:Name="Liste" Background="{StaticResource Encre}" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fond" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Or}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== menus (clic droit, + Ajouter, Projection) ===================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Encre}" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fond" Background="Transparent" CornerRadius="7" Padding="8,8,12,8" MinWidth="220">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Coche" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="{StaticResource Or}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                                <Path x:Name="Fleche" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Brume}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource Encre}" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Fleche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource Trait}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== listes (chants, déroulé, sources) ===================== -->
    <Style x:Key="ListeChants" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="0,0,4,0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ElementChant" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fond" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Nuit2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource OrLeger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- élément d'une liste présenté en carte encadrée (bibliothèque Display, dossiers Duo) -->
    <Style x:Key="ElementCarte" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="Padding" Value="14,12,10,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fond" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Trait2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource OrVif}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- section des Réglages : une carte -->
    <Style x:Key="Section" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Nuit}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- pastille encadrée : « ● Moteur OBS 33.0.1 » -->
    <Style x:Key="Puce" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== info-bulles ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Encre}" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait2}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== cartes et touches ===================== -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Nuit}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="Touche" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Nuit2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== fenêtres de dialogue ===================== -->
    <Style x:Key="Dialogue" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Nuit}" />
        <Setter Property="Foreground" Value="{StaticResource Blanc}" />
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
</ResourceDictionary>
