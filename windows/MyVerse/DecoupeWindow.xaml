<local:FenetreDialogue x:Class="MyVerse.Ui.DecoupeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Découper la diapositive" Width="980" Height="560" MinWidth="700" MinHeight="420" ResizeMode="CanResize">
    <DockPanel Margin="22,18,22,20">
        <TextBlock DockPanel.Dock="Top" Text="Découper la diapositive" Style="{StaticResource Titre2}" Margin="0,0,0,8" />
        <TextBlock x:Name="Aide" DockPanel.Dock="Top" Style="{StaticResource Muet}" FontSize="14" Margin="0,0,0,12" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="UnSeul" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Un seul morceau" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Annuler" Style="{StaticResource Btn}" Content="Annuler" IsCancel="True" MinWidth="110" />
                <Button x:Name="Enregistrer" Style="{StaticResource BtnOr}" Content="Enregistrer" Margin="10,0,0,0" MinWidth="130" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Texte" Style="{StaticResource Zone}" FontSize="15" SpellCheck.IsEnabled="False" />
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" FontSize="13" Foreground="{StaticResource Brume2}" Margin="0,0,0,6">
                    <Run Text="Diapositives" /> <Run x:Name="Compte" FontWeight="Bold" Foreground="{StaticResource Brume}" />
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="Apercu" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</local:FenetreDialogue>
